# Redis Connection
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Queue Settings
QUEUE_NAME=queueguard
MAX_RETRIES=3
RETRY_BACKOFF_BASE=2

# Optional: LLM API for enhanced failure analysis (leave blank to use local engine)
# OPENAI_API_KEY=
# GEMINI_API_KEY=

# Logging
LOG_LEVEL=INFO
